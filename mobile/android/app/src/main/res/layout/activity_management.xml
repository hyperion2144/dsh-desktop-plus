<?xml version="1.0" encoding="utf-8"?>
<!--
  原生管理页（原型定稿变体 A）：当前主机大卡 + 主机卡片列表 + 偏好分组 + 右下 FAB。
  结构对照 prototype/ui-mock/index.html 第①屏；色值与圆角全部取自 values/colors.xml、values/dimens.xml。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dsh_bg_base"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/management_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- 顶栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_back"
                    android:padding="5dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/management_title"
                    android:textColor="@color/dsh_label_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 当前主机大卡 -->
            <LinearLayout
                android:id="@+id/card_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/dsh_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_current"
                        android:layout_width="@dimen/dsh_status_dot"
                        android:layout_height="@dimen/dsh_status_dot"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/name_current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/management_no_host"
                        android:textColor="@color/dsh_label_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/form_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="10sp"
                        android:visibility="gone" />


                    <TextView
                        android:id="@+id/latency_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dsh_label_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/dsh_label_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 主机分组 -->
            <TextView
                android:id="@+id/group_hosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="@string/management_group_hosts"
                android:textColor="@color/dsh_label_tertiary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/host_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/hint_hosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:text="@string/management_hint_remove"
                android:textColor="@color/dsh_label_caption"
                android:textSize="12sp" />

            <!-- 发现分组：扫描局域网里的 dsh 桌面（发现不带授权） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/group_discovery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/discovery_group"
                    android:textColor="@color/dsh_label_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_discovery_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="@string/discovery_scan"
                    android:textColor="@color/dsh_deepseek_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/discovery_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/hint_discovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:text="@string/discovery_hint"
                android:textColor="@color/dsh_label_caption"
                android:textSize="12sp" />

            <!-- 偏好分组 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="@string/management_group_prefs"
                android:textColor="@color/dsh_label_tertiary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dsh_row_padding">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_update_title"
                            android:textColor="@color/dsh_label_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_update_desc"
                            android:textColor="@color/dsh_label_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dsh_border_l1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dsh_row_padding">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_lock_title"
                            android:textColor="@color/dsh_label_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_lock_desc"
                            android:textColor="@color/dsh_label_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_lock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dsh_border_l1" />

                <!-- 外观：跟随系统 / 浅色 / 深色（点击弹出单选，选中即生效） -->
                <LinearLayout
                    android:id="@+id/pref_appearance_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dsh_row_padding">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pref_appearance_title"
                        android:textColor="@color/dsh_label_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pref_appearance_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/appearance_system"
                        android:textColor="@color/dsh_label_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/fab_pair"
        android:layout_width="@dimen/dsh_fab_size"
        android:layout_height="@dimen/dsh_fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/pair_fab"
        android:padding="14dp"
        android:src="@drawable/ic_add" />
</FrameLayout>
