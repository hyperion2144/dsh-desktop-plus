<?xml version="1.0" encoding="utf-8"?>
<!-- 主机列表的一行：状态点 + 名字/地址 + 形态徽标 +「当前」标记。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/host_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/dsh_row_padding">

    <View
        android:id="@+id/dot_row"
        android:layout_width="@dimen/dsh_status_dot"
        android:layout_height="@dimen/dsh_status_dot"
        android:background="@drawable/bg_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dsh_label_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/origin_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dsh_label_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/form_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/current_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/host_current_marker"
        android:textColor="@color/dsh_deepseek_400"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
