<?xml version="1.0" encoding="utf-8"?>
<!--
  浮层切换器的一行：状态点 + 名字/副行（地址 · 状态 · 已配对）+ 形态徽标 +「当前」。
  状态点与形态徽标的颜色由 HostVisuals 按状态/形态绑定（与管理页同一套映射）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/switcher_dot"
        android:layout_width="@dimen/dsh_status_dot"
        android:layout_height="@dimen/dsh_status_dot"
        android:background="@drawable/bg_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/switcher_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dsh_label_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/switcher_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dsh_label_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/switcher_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/switcher_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/host_current_marker"
        android:textColor="@color/dsh_deepseek_400"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
