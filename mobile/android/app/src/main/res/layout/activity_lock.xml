<?xml version="1.0" encoding="utf-8"?>
<!--
  生物锁屏（原型定稿第④屏）：冷启动 / 后台超时回前台 / 敏感操作三触发共用。
  验证失败时由系统回退到设备凭据（PIN / 图案 / 密码）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dsh_bg_base"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <TextView
        android:id="@+id/lock_mark"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:background="@drawable/bg_brand_mark"
        android:gravity="center"
        android:text="D"
        android:textColor="@android:color/white"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lock_title"
        android:textColor="@color/dsh_label_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/lock_reason_cold"
        android:textColor="@color/dsh_label_tertiary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:text="@string/lock_verify"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/lock_hint"
        android:textColor="@color/dsh_label_caption"
        android:textSize="12sp" />
</LinearLayout>
