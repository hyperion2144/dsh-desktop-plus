<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只声明 INTERNET：targetSdk ≤ 36 时局域网访问靠它隐式授予。
         不要声明 ACCESS_LOCAL_NETWORK——那是 Android 17（targetSdk 37）的门禁，
         本壳 targetSdk 锁 36（docs/agents/research/webview-shell-constraints.md）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 更新提醒：下载后拉起系统安装器需要「安装未知来源应用」的权限。
         权限本身在运行时由用户授权（设置页），清单里只做声明。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 扫码配对需要相机（运行时申请；设备没相机时走「粘贴配对链接」）。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 连接保活前台服务：页面工作台活跃期间保持进程不被冻结（connectedDevice 类型）。
         不申请 POST_NOTIFICATIONS：未授权时通知不展示、服务照常运行。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MobileApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshMobile">

        <!-- 明暗切换（跟随系统）不接管 uiMode：明暗一变就得重建界面，
             否则已 inflate 的视图还拿着旧一版的 dsh_* 颜色。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 原生管理页（主机 / 偏好 / 配对入口） -->
        <activity
            android:name=".shell.ui.ManagementActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 配对屏（扫码 / 粘贴链接 → 验证 → 成功 / 失败） -->
        <activity
            android:name=".shell.ui.PairingActivity"
            android:exported="false"
            android:parentActivityName=".shell.ui.ManagementActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 生物锁屏：不可绕过，不出现在最近任务里 -->
        <activity
            android:name=".shell.ui.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ZXing 扫码页（zxing-android-embedded） -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <!-- FileProvider：把私有目录里的 apk 以 content:// 交给系统安装器。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 连接保活：后台期间 WebView 的长连接不被冻结。 -->
        <service
            android:name=".shell.connect.KeepaliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
