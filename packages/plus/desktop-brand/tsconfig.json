{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "react": ["../../../upstream/node_modules/@types/react"],
      "react/jsx-runtime": ["../../../upstream/node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "types/**/*.d.ts"]
}
