{
  "name": "@deepseek-ai/dsh-desktop-plus-remote-access",
  "version": "0.2.2-rc.1",
  "description": "远程访问服务：Host/Origin 改写反代 + 配对（扫码/输入地址）+ SSE 设备会话 + cloudflared 隧道（DSH Desktop Plus 内置包）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
