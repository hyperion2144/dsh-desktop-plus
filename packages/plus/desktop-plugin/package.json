{
  "name": "@deepseek-ai/dsh-desktop-plus-plugin",
  "version": "0.1.0",
  "description": "dsh-desktop-plus 桌面插件：给 dsh 页面注入桌面 chrome（桌面设置面板/通知/下载/快捷键桥/控制台镜像），并注册「DSH 桌面壳」技能；壳侧服务经同源 /__shell__/rpc 暴露",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperion2144/dsh-desktop-plus.git"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./contracts": "./contracts/index.ts"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "desktop",
    "electron",
    "dsh-desktop-plus",
    "skill"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/react": "^18",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
