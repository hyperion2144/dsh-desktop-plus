+/**
+ * Framework-free degraded-boot notice: names the client entries that never
+ * activated and were skipped, with reload-to-retry and dismiss controls. It
+ * mounts at the document body so it survives the boot page disposal and does
+ * not depend on any client plugin having loaded.
+ * @module @deepseek-ai/dsh-client-web/src/boot-degraded
+ */
+import type { SkippedEntry } from './boot-client.ts'
+import css from './boot-page.module.css'
+
+/** Create a div with one module class and optional text. */
+function div(className: string | undefined, text?: string): HTMLDivElement {
+  const el = document.createElement('div')
+  el.className = className ?? ''
+  if (text !== undefined) el.textContent = text
+  return el
+}
+
+/** Create a button with one module class, a data attribute hook and a click action. */
+function button(className: string | undefined, hook: 'retry' | 'dismiss', label: string, action: () => void): HTMLButtonElement {
+  const el = document.createElement('button')
+  el.type = 'button'
+  el.className = className ?? ''
+  if (hook === 'retry') el.dataset.dshBootDegradedRetry = ''
+  else el.dataset.dshBootDegradedDismiss = ''
+  el.textContent = label
+  el.addEventListener('click', () => { action() })
+  return el
+}
+
+/**
+ * Mount the degraded notice under `parent`.
+ * @param parent - Element the notice attaches to (the document body in production).
+ * @param skipped - Entries the boot skipped, in audit order.
+ * @param reload - Retry action; reloads the page by default.
+ * @returns the mounted notice root.
+ */
+export function mountDegradedNotice(
+  parent: HTMLElement,
+  skipped: readonly SkippedEntry[],
+  reload: () => void = () => { location.reload() },
+): HTMLElement {
+  const root = div(css.degraded)
+  root.dataset.dshBootDegraded = ''
+  const text = div(css.degradedText, skipped.length === 1
+    ? '1 plugin failed to load and was skipped:'
+    : `${String(skipped.length)} plugins failed to load and were skipped:`)
+  const list = div(css.degradedList)
+  for (const entry of skipped) list.append(div(css.degradedItem, entry.name))
+  const actions = div(css.degradedActions)
+  actions.append(
+    button(css.degradedButton, 'retry', 'Retry', () => { reload() }),
+    button(css.degradedButton, 'dismiss', 'Dismiss', () => { root.remove() }),
+  )
+  root.append(text, list, actions)
+  parent.append(root)
+  return root
+}
