--- /dev/null
+++ b/upstream/packages/client/web/tests/boot-degraded.client.spec.ts
@@ -0,0 +1,47 @@
+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest'
+import { mountDegradedNotice } from '../src/boot-degraded.ts'
+
+describe('mountDegradedNotice', () => {
+  it('lists skipped entries and retries by reloading', () => {
+    const reload = vi.fn()
+    const parent = document.createElement('div')
+    document.body.append(parent)
+
+    const notice = mountDegradedNotice(parent, [
+      { name: 'ghost', reason: 'ghost: import failed: bundle script failed to load' },
+      { name: 'lost', reason: 'lost: pending (waiting for service: ghost)' },
+    ], reload)
+
+    expect(parent.querySelector('[data-dsh-boot-degraded]')).toBe(notice)
+    expect(notice.textContent).toContain('2 plugins failed to load')
+    expect(notice.textContent).toContain('ghost')
+    expect(notice.textContent).toContain('lost')
+    const retry = notice.querySelector<HTMLButtonElement>('[data-dsh-boot-degraded-retry]')
+    expect(retry).not.toBeNull()
+    retry!.click()
+    expect(reload).toHaveBeenCalledOnce()
+    expect(parent.contains(notice)).toBe(true)
+  })
+
+  it('removes itself when dismissed', () => {
+    const parent = document.createElement('div')
+    document.body.append(parent)
+
+    const notice = mountDegradedNotice(parent, [{ name: 'ghost', reason: 'gone' }], vi.fn())
+
+    const dismiss = notice.querySelector<HTMLButtonElement>('[data-dsh-boot-degraded-dismiss]')
+    expect(dismiss).not.toBeNull()
+    dismiss!.click()
+    expect(parent.contains(notice)).toBe(false)
+  })
+
+  it('uses the singular copy for one skipped entry', () => {
+    const parent = document.createElement('div')
+    document.body.append(parent)
+
+    const notice = mountDegradedNotice(parent, [{ name: 'ghost', reason: 'gone' }], vi.fn())
+
+    expect(notice.textContent).toContain('1 plugin failed to load')
+  })
+})
