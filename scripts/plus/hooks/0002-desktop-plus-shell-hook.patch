diff --git a/upstream/apps/desktop/tests/desktop-window.spec.ts b/upstream/apps/desktop/tests/desktop-window.spec.ts
new file mode 100644
index 00000000..05caff30
--- /dev/null
+++ b/upstream/apps/desktop/tests/desktop-window.spec.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from 'vitest'
+import {
+  desktopChromeFill, desktopWindowOptions, desktopWindowRole, desktopWindowRoleArgument, isLocalDesktopRole,
+  type DesktopWindowRole
+} from '../src/desktop-window.ts'
+import { WINDOWS_TITLEBAR_HEIGHT } from '../src/windows-layout.ts'
+
+/** Options one window is constructed from, with the per-window identity fields kept apart. */
+function options(role: DesktopWindowRole, platform: NodeJS.Platform, dark = false, partition?: string) {
+  return desktopWindowOptions({
+    role, preload: `/app/preload-${role}.cjs`, show: false, platform, dark,
+    ...(partition === undefined ? {} : { partition })
+  })
+}
+
+/** Every option except the identity a caller legitimately owns (preload, partition, role argument). */
+function chromeOf(values: ReturnType<typeof options>) {
+  const { preload: _preload, additionalArguments: _arguments, ...webPreferences } = values.webPreferences ?? {}
+  return { ...values, webPreferences }
+}
+
+describe('desktop window construction', () => {
+  it.each(['darwin', 'win32', 'linux'] as const)('builds every window role from identical chrome on %s', (platform) => {
+    const product = chromeOf(options('product', platform))
+    expect(chromeOf(options('profile', platform))).toEqual(product)
+    expect(chromeOf(options('remote', platform))).toEqual(product)
+  })
+
+  it.each(['darwin', 'win32'] as const)('hides native window controls in every window on %s', (platform) => {
+    for (const role of ['product', 'profile', 'remote'] as const) {
+      const values = options(role, platform)
+      expect(values.titleBarStyle).toBe(platform === 'win32' ? 'hidden' : 'hiddenInset')
+    }
+  })
+
+  it('gives a Windows window the caption overlay that its page reports into', () => {
+    for (const role of ['product', 'profile', 'remote'] as const) {
+      const values = options(role, 'win32')
+      expect(values.titleBarOverlay).toEqual({
+        height: WINDOWS_TITLEBAR_HEIGHT,
+        color: desktopChromeFill(false), symbolColor: '#0f1115'
+      })
+    }
+  })
+
+  it('uses the opaque sidebar fill for the Windows base and a transparent one for macOS vibrancy', () => {
+    expect(options('profile', 'win32', true).backgroundColor).toBe(desktopChromeFill(true))
+    expect(options('profile', 'win32').titleBarOverlay).toMatchObject({ color: desktopChromeFill(false) })
+    const darwin = options('profile', 'darwin')
+    expect(darwin.backgroundColor).toBe('#00000000')
+    expect(darwin.vibrancy).toBe('sidebar')
+    expect(darwin.visualEffectState).toBe('active')
+  })
+
+  it('lets every desktop window host the sidebar webview', () => {
+    for (const role of ['product', 'profile', 'remote'] as const) {
+      expect(options(role, 'darwin').webPreferences?.webviewTag).toBe(true)
+    }
+  })
+
+  it('isolates only the session of a partitioned profile window', () => {
+    expect(options('profile', 'darwin', false, 'persist:dsh-profile-work').webPreferences?.partition)
+      .toBe('persist:dsh-profile-work')
+    expect(options('product', 'darwin').webPreferences?.partition).toBeUndefined()
+  })
+
+  it('declares the role to the renderer instead of letting it infer one from the document', () => {
+    const values = options('profile', 'darwin')
+    expect(values.webPreferences?.additionalArguments).toEqual([desktopWindowRoleArgument('profile')])
+    expect(desktopWindowRole(values.webPreferences?.additionalArguments ?? [])).toBe('profile')
+  })
+})
+
+describe('window role arguments', () => {
+  it('accepts the three declared roles', () => {
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('product')])).toBe('product')
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('profile')])).toBe('profile')
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('remote')])).toBe('remote')
+  })
+
+  it('accepts a repeated declaration and refuses conflicting ones', () => {
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('product'), desktopWindowRoleArgument('product')])).toBe('product')
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('remote'), desktopWindowRoleArgument('product')])).toBeUndefined()
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('product'), desktopWindowRoleArgument('profile')])).toBeUndefined()
+  })
+
