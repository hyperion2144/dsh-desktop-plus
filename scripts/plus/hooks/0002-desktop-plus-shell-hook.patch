diff --git a/upstream/apps/desktop/tests/remote-drag.spec.ts b/upstream/apps/desktop/tests/remote-drag.spec.ts
new file mode 100644
index 00000000..3eb88ffb
--- /dev/null
+++ b/upstream/apps/desktop/tests/remote-drag.spec.ts
@@ -0,0 +1,90 @@
+import { createHash } from 'node:crypto'
+import { readFile, rm } from 'node:fs/promises'
+import { basename } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+
+const electron = vi.hoisted(() => ({ net: { fetch: vi.fn() } }))
+vi.mock('electron', () => electron)
+const { fetchRemoteDragResource } = await import('../src/remote-drag.ts')
+/** A window session already holding the pairing cookie for the remote origin. */
+const PAIRED = { cookies: { get: async () => [{ name: 'dsh_mobile_session', value: 'paired-cookie' }] } }
+const doFetch = vi.fn()
+
+const ADDRESS = 'dsh-resource://file/session/session-1/report.pdf'
+/** The page's drag source: the name here is what the drag layer verifies. */
+const SOURCE = { address: ADDRESS, name: 'report.pdf', mediaType: 'application/pdf' }
+const ORIGIN = 'https://lane.example'
+
+/** One multipart answer shaped like the Host's binary RPC response. */
+function binaryResponse(bytes: Uint8Array, rpcId: string): Response {
+  const metadata = JSON.stringify({
+    type: 'server-response',
+    rpcId,
+    result: { ok: true, value: { data: null, offset: 0, eof: true } },
+    attachments: [{ codec: 'bytes', part: 'data', path: ['data'] }],
+  })
+  const form = new FormData()
+  form.set('metadata', metadata)
+  form.set('data', new Blob([new Uint8Array(bytes)]))
+  // A real Response derives the multipart boundary the parser needs.
+  return new Response(form)
+}
+
+afterEach(() => { vi.clearAllMocks() })
+
+it('downloads a remote resource through the window session and reports its identity', async () => {
+  const bytes = Buffer.from('remote artifact bytes')
+  doFetch.mockImplementation(async (_url: string, init: { body: string }) => {
+    const envelope = JSON.parse(init.body) as { rpcId: string }
+    return binaryResponse(bytes, envelope.rpcId)
+  })
+  const resource = await fetchRemoteDragResource(doFetch as never, PAIRED as never, ORIGIN, SOURCE, new AbortController().signal)
+  expect(resource).not.toBeNull()
+  expect(resource!.size).toBe(bytes.byteLength)
+  expect(resource!.sha256).toBe(createHash('sha256').update(bytes).digest('hex'))
+  expect(await readFile(resource!.path)).toEqual(bytes)
+  // The drag layer compares this basename against the name the page declared.
+  expect(basename(resource!.path)).toBe('report.pdf')
+  // The request carries the window's pairing cookie, so the remote Host authorizes it.
+  expect(doFetch).toHaveBeenCalledWith(
+    `${ORIGIN}/api/workspaceFiles/readBytes`,
+    expect.objectContaining({ method: 'POST', headers: expect.objectContaining({ cookie: 'dsh_mobile_session=paired-cookie' }) }),
+  )
+  await rm(resource!.path, { force: true })
+})
+
+it('asks for the session-scoped file the address names', async () => {
+  doFetch.mockImplementation(async (_url: string, init: { body: string }) => {
+    const envelope = JSON.parse(init.body) as { rpcId: string; method: string; payload: unknown[] }
+    expect(envelope.method).toBe('workspaceFiles/readBytes')
+    expect(envelope.payload[0]).toEqual({ sessionId: 'session-1', workspaceRoot: '' })
+    expect(envelope.payload[1]).toBe('report.pdf')
+    return binaryResponse(Buffer.from('x'), envelope.rpcId)
+  })
+  const resource = await fetchRemoteDragResource(doFetch as never, PAIRED as never, ORIGIN, SOURCE, new AbortController().signal)
+  expect(resource).not.toBeNull()
+  await rm(resource!.path, { force: true })
+})
+
+it.each([
+  ['a non-session address', 'dsh-resource://file/absolute/etc/passwd'],
+  ['a malformed address', 'not-an-address'],
+])('refuses %s without a request', async (_name, address) => {
+  await expect(fetchRemoteDragResource(doFetch as never, PAIRED as never, ORIGIN, { ...SOURCE, address }, new AbortController().signal)).resolves.toBeNull()
+  expect(doFetch).not.toHaveBeenCalled()
+})
+
+it('reports no resource when the Host refuses or answers something else', async () => {
+  doFetch.mockResolvedValueOnce(new Response(null, { status: 403 }))
+  await expect(fetchRemoteDragResource(doFetch as never, PAIRED as never, ORIGIN, SOURCE, new AbortController().signal)).resolves.toBeNull()
+  doFetch.mockResolvedValueOnce(new Response('{}', { status: 200, headers: { 'content-type': 'application/json' } }))
+  await expect(fetchRemoteDragResource(doFetch as never, PAIRED as never, ORIGIN, SOURCE, new AbortController().signal)).resolves.toBeNull()
+})
+
+it('reports no resource when the answer carries no bytes', async () => {
+  doFetch.mockImplementation(async (_url: string, init: { body: string }) => {
+    const envelope = JSON.parse(init.body) as { rpcId: string }
+    return binaryResponse(new Uint8Array(), envelope.rpcId)
+  })
+  await expect(fetchRemoteDragResource(doFetch as never, PAIRED as never, ORIGIN, SOURCE, new AbortController().signal)).resolves.toBeNull()
+})
