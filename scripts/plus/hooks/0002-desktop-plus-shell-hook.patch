+import { describe, expect, it } from 'vitest'
+import { desktopWindowRole, desktopWindowRoleArgument, isLocalDesktopRole } from '../src/desktop-window.ts'
+
+describe('window role arguments', () => {
+  it('accepts the two declared roles', () => {
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('local')])).toBe('local')
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('remote')])).toBe('remote')
+  })
+
+  it('accepts a repeated declaration and refuses conflicting ones', () => {
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('local'), desktopWindowRoleArgument('local')])).toBe('local')
+    expect(desktopWindowRole(['electron', desktopWindowRoleArgument('remote'), desktopWindowRoleArgument('local')])).toBeUndefined()
+  })
+
+  it('treats only a locally served document as machine-local', () => {
+    expect(isLocalDesktopRole('local')).toBe(true)
+    expect(isLocalDesktopRole('remote')).toBe(false)
+  })
+
+  it('reports no role for a renderer the shell did not construct', () => {
+    expect(desktopWindowRole(['electron'])).toBeUndefined()
+    expect(desktopWindowRole(['electron', '--dsh-desktop-window=other'])).toBeUndefined()
+    expect(desktopWindowRole(['electron', '--dsh-desktop-window='])).toBeUndefined()
+  })
+})
