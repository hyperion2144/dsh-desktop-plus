--- /dev/null
+++ b/upstream/apps/desktop/src/desktop-window.ts
@@ -0,0 +1,131 @@
+/** The one construction path for every desktop-shell window: chrome, web preferences, and capability role. */
+
+import type { BrowserWindowConstructorOptions } from 'electron'
+import { WINDOWS_TITLEBAR_HEIGHT } from './windows-layout.ts'
+
+/**
+ * The document role a shell window hosts. The role is a window property: the
+ * main process declares it when it constructs the window, and the preload reads
+ * it back from its own argv. Nothing in the renderer decides its desktop
+ * capability from the document URL it happens to load.
+ *
+ * `product` serves the application document, `profile` serves a local profile
+ * Host, and `remote` shows a profile whose backend and resources live on another
+ * machine while the front end still runs from this install. All three are real
+ * desktop windows and get the same capability carrier; only the two globals that
+ * mean "this machine" (native directory dialog, host file paths) are withheld
+ * from `remote`, where the correct answer comes from the remote Host instead.
+ */
+export type DesktopWindowRole = 'product' | 'profile' | 'remote'
+
+/** Roles whose document is served by this machine, so machine-local globals apply. */
+export const LOCAL_DESKTOP_ROLES: readonly DesktopWindowRole[] = ['product', 'profile']
+
+/**
+ * Whether a role hosts a document served by this machine, so globals that mean
+ * "a path or dialog on this computer" are correct for it.
+ * @param role - role declared by the constructing window.
+ * @returns true for a window whose document comes from this machine.
+ */
+export function isLocalDesktopRole(role: DesktopWindowRole): boolean {
+  return LOCAL_DESKTOP_ROLES.includes(role)
+}
+
+/** `webPreferences.additionalArguments` switch that carries the role to the preload. */
+const ROLE_SWITCH = '--dsh-desktop-window='
+
+/**
+ * Encode one window role for the renderer.
+ * @param role - role declared by the constructing window.
+ * @returns the additional-argument token the preload reads.
+ */
+export function desktopWindowRoleArgument(role: DesktopWindowRole): string {
+  return `${ROLE_SWITCH}${role}`
+}
+
+/**
+ * Read the role the main process declared for this renderer.
+ * @param argv - renderer process argv (sandboxed preloads see the same array).
+ * @returns the declared role, or undefined when this renderer is not a shell window.
+ */
+export function desktopWindowRole(argv: readonly string[]): DesktopWindowRole | undefined {
+  // Every declaration must agree: two different roles mean the renderer cannot be
+  // classified, so it gets no desktop capability at all.
+  const declared = argv.filter(value => value.startsWith(ROLE_SWITCH)).map(value => value.slice(ROLE_SWITCH.length))
+  const role = declared.at(-1)
+  if (role === undefined || declared.some(value => value !== role)) return undefined
+  return role === 'product' || role === 'profile' || role === 'remote' ? role : undefined
+}
+
+/**
+ * The opaque chrome fill matching the built-in sidebar palette (the resolved
+ * `--dsw-static-neutral-bluish-900` / `-50` tokens).
+ * @param dark - whether the effective application palette is dark.
+ * @returns the sidebar fill hex color.
+ */
+export function desktopChromeFill(dark: boolean): string {
+  return dark ? '#1b1b1c' : '#f9fafb'
+}
+
+/** Inputs the shared window construction resolves from. */
+export interface DesktopWindowOptionsInput {
+  /** Declared window role; only the renderer capability argument derives from it. */
+  readonly role: DesktopWindowRole
+  /** Absolute preload script path. */
+  readonly preload: string
+  /** Create the window visible. */
+  readonly show: boolean
+  /** Session partition for an isolated profile window; the default session otherwise. */
+  readonly partition?: string
+  /** Host platform, passed in so the options are a pure function. */
+  readonly platform: NodeJS.Platform
+  /** Effective application palette is dark. */
+  readonly dark: boolean
+}
+
+/**
+ * Build the options every desktop-shell window is constructed from. Product and
+ * profile windows differ in their preload arguments and session partition only:
+ * native chrome, transparency, and web preferences are identical, so a profile
+ * window that follows this path is a desktop window rather than an imitation.
+ * @param input - role, preload, visibility, partition, platform, and palette.
+ * @returns the BrowserWindow options for one desktop-shell window.
+ */
+export function desktopWindowOptions(input: DesktopWindowOptionsInput): BrowserWindowConstructorOptions {
+  const { role, preload, show, partition, platform, dark } = input
+  return {
+    width: 1280,
+    height: 820,
+    minWidth: 520,
+    minHeight: 600,
+    show,
+    ...(platform === 'win32' ? {
+      backgroundColor: desktopChromeFill(dark),
+      titleBarStyle: 'hidden' as const,
+      titleBarOverlay: { height: WINDOWS_TITLEBAR_HEIGHT, color: desktopChromeFill(dark),
+        symbolColor: dark ? '#f9fafb' : '#0f1115' },
+    } : {}),
+    // hiddenInset places traffic lights inside the sidebar; sidebar vibrancy
+    // needs a transparent window background to show through the page.
+    ...(platform === 'darwin' ? {
+      titleBarStyle: 'hiddenInset' as const,
+      trafficLightPosition: { x: 16, y: 18 },
+      vibrancy: 'sidebar' as const,
+      // 'active' keeps the vibrancy material stable when the window blurs;
+      // 'followWindow' washes the sidebar out behind an unfocused window.
+      visualEffectState: 'active' as const,
+      backgroundColor: '#00000000',
+    } : {}),
+    webPreferences: {
+      preload,
+      ...(partition === undefined ? {} : { partition }),
+      nodeIntegration: false,
+      contextIsolation: true,
+      sandbox: true,
+      webSecurity: true,
+      webviewTag: true,
+      devTools: true,
+      additionalArguments: [desktopWindowRoleArgument(role)],
+    },
+  }
+}
