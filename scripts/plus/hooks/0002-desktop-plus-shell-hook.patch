index 00000000..3eb8fb87
--- /dev/null
+++ b/upstream/apps/desktop/src/remote-drag.ts
@@ -0,0 +1,139 @@
+/** Fetch a remote profile's drag resource into a local temporary file. */
+
+import { createHash } from 'node:crypto'
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { Session } from 'electron'
+import { parseFileAddress } from '@deepseek-ai/dsh-util-workspace-path'
+import { resolveDragFileName, type DragFileName } from '@deepseek-ai/dsh-util-file-drag'
+import type { ConfiguredFetch } from '@deepseek-ai/dsh-desktop-plus-shell'
+
+/** One resource materialized on this machine, ready for a native drag. */
+export interface RemoteDragResource {
+  /** Absolute path of the downloaded copy. */
+  readonly path: string
+  /** Private directory holding the copy; the caller removes it once the drag ends. */
+  readonly directory: string
+  /** Byte length of the downloaded copy. */
+  readonly size: number
+  /** SHA-256 of the downloaded copy, as the drag layer verifies. */
+  readonly sha256: string
+}
+
+
+/** One RPC envelope as the Host's `/api` channel expects it. */
+interface RpcEnvelope {
+  readonly type: 'client-request'
+  readonly rpcId: string
+  readonly method: string
+  readonly payload: unknown
+}
+
+/**
+ * Read one byte window of a remote workspace file through the Host's `/api` RPC channel.
+ *
+ * The window's own session carries the pairing cookie, so the request is authorized
+ * exactly like the page's own calls; nothing here handles credentials.
+ * @param session - the profile window's session, which holds the remote cookie.
+ * @param origin - remote Host origin.
+ * @param address - `dsh-resource://file/session/<id>/<path>` reference.
+ * @param signal - caller cancellation.
+ * @returns the file's bytes, or null when the address is not a session resource.
+ */
+async function readRemoteBytes(
+  doFetch: ConfiguredFetch, session: Session, origin: string, address: string, signal: AbortSignal,
+): Promise<Uint8Array | null> {
+  const resource = parseFileAddress(address)
+  if (resource?.scope !== 'session') return null
+  const rpcId = `plus-drag-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`
+  const envelope: RpcEnvelope = {
+    type: 'client-request',
+    rpcId,
+    method: 'workspaceFiles/readBytes',
+    payload: [
+      { sessionId: resource.sessionId, workspaceRoot: '' },
+      resource.path,
+      {},
+      null,
+    ],
+  }
+  // The window's own session carries the pairing cookie, so the request is authorized
+  // exactly like the page's own calls; the shell fetch keeps the proxy answer consistent.
+  const response = await doFetch(`${origin}/api/workspaceFiles/readBytes`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json', cookie: await sessionCookie(session, origin) },
+    body: JSON.stringify(envelope),
+    signal,
+  })
+  if (!response.ok) return null
+  const mediaType = response.headers.get('content-type')?.split(';', 1)[0]?.trim().toLowerCase()
+  if (mediaType !== 'multipart/form-data') return null
+  const form = await response.formData()
+  const metadata = form.get('metadata')
+  if (typeof metadata !== 'string') return null
+  const parsed: unknown = JSON.parse(metadata)
+  const answer = parsed as { result?: { ok?: unknown; value?: unknown }, attachments?: unknown }
+  const result = answer.result
+  if (result?.ok !== true || typeof result.value !== 'object' || result.value === null) return null
+  // The Host sends the bytes as a multipart part and leaves a null placeholder in the
+  // answer; the Client normally splices them in, so this reader does the same.
+  const attachments = Array.isArray(answer.attachments) ? answer.attachments : []
+  const value = result.value as { data?: unknown }
+  for (const attachment of attachments) {
+    if (typeof attachment !== 'object' || attachment === null) continue
+    const { codec, part, path } = attachment as { codec?: unknown; part?: unknown; path?: unknown }
+    if (codec !== 'bytes' || typeof part !== 'string' || !Array.isArray(path)) continue
+    if (path.length !== 1 || path[0] !== 'data') continue
+    const blob = form.get(part)
+    if (!(blob instanceof Blob)) continue
+    value.data = new Uint8Array(await blob.arrayBuffer())
+  }
+  if (!(value.data instanceof Uint8Array)) return null
+  return value.data
+}
+
+
+/**
+ * The pairing cookie the window's session holds for this origin.
+ * @param session - the profile window's session.
+ * @param origin - remote Host origin.
+ * @returns a `cookie` header value, or '' when the window is not paired yet.
+ */
+async function sessionCookie(session: Session, origin: string): Promise<string> {
+  const stored = await session.cookies.get({ name: 'dsh_mobile_session', url: origin }).catch(() => [])
+  return stored.map((cookie) => `${cookie.name}=${cookie.value}`).join('; ')
+}
+/**
+ * Materialize a remote profile's drag resource as a local temporary file.
+ *
+ * A drag out of a remote profile means "download to this machine": the bytes come from
+ * the remote Host through the window's own authenticated session, land in a private
+ * temporary directory under the name the drag layer verifies, and the native drag then
+ * carries that local copy. The directory is owned by the caller so it can be removed
+ * once the drag ends.
+ * @param doFetch - the shell's configured fetch.
+ * @param session - the profile window's session.
+ * @param origin - remote Host origin.
+ * @param source - the page's drag source, whose name the drag layer verifies.
+ * @param signal - caller cancellation.
+ * @returns the local copy, or null when the resource cannot be read.
+ */
+export async function fetchRemoteDragResource(
+  doFetch: ConfiguredFetch, session: Session, origin: string, source: { readonly address: string } & DragFileName,
+  signal: AbortSignal,
+): Promise<RemoteDragResource | null> {
+  const bytes = await readRemoteBytes(doFetch, session, origin, source.address, signal)
+  if (bytes === null || bytes.byteLength === 0) return null
+  signal.throwIfAborted()
+  const directory = await mkdtemp(join(tmpdir(), 'dsh-plus-drag-'))
+  // The drag layer compares this basename against the name the page declared.
+  const path = join(directory, resolveDragFileName(source))
+  try {
+    await writeFile(path, bytes)
+  } catch (error) {
+    await rm(directory, { recursive: true, force: true }).catch(() => undefined)
+    throw error
+  }
+  return { path, directory, size: bytes.byteLength, sha256: createHash('sha256').update(bytes).digest('hex') }
+}
