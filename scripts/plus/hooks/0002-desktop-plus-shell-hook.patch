diff --git a/upstream/apps/desktop/src/desktop-window.ts b/upstream/apps/desktop/src/desktop-window.ts
new file mode 100644
index 00000000..f6179bfb
--- /dev/null
+++ b/upstream/apps/desktop/src/desktop-window.ts
@@ -0,0 +1,57 @@
+/** The one construction path for every desktop-shell window: chrome, web preferences, and capability role. */
+
+
+/**
+ * The document role a shell window hosts. The role is a window property: the
+ * main process declares it when it constructs the window, and the preload reads
+ * it back from its own argv. Nothing in the renderer decides its desktop
+ * capability from the document URL it happens to load.
+ *
+ * `local` serves a profile Host on this machine, and `remote` shows a profile
+ * whose backend and resources live on another machine while the front end still
+ * runs from this install. Both are real desktop windows and get the same
+ * capability carrier; only the two globals that mean "this machine" (native
+ * directory dialog, host file paths) are withheld from `remote`, where the
+ * correct answer comes from the remote Host instead.
+ */
+export type DesktopWindowRole = 'local' | 'remote'
+
+/** Roles whose document is served by this machine, so machine-local globals apply. */
+export const LOCAL_DESKTOP_ROLES: readonly DesktopWindowRole[] = ['local']
+
+/**
+ * Whether a role hosts a document served by this machine, so globals that mean
+ * "a path or dialog on this computer" are correct for it.
+ * @param role - role declared by the constructing window.
+ * @returns true for a window whose document comes from this machine.
+ */
+export function isLocalDesktopRole(role: DesktopWindowRole): boolean {
+  return LOCAL_DESKTOP_ROLES.includes(role)
+}
+
+/** `webPreferences.additionalArguments` switch that carries the role to the preload. */
+const ROLE_SWITCH = '--dsh-desktop-window='
+
+/**
+ * Encode one window role for the renderer.
+ * @param role - role declared by the constructing window.
+ * @returns the additional-argument token the preload reads.
+ */
+export function desktopWindowRoleArgument(role: DesktopWindowRole): string {
+  return `${ROLE_SWITCH}${role}`
+}
+
+/**
+ * Read the role the main process declared for this renderer.
+ * @param argv - renderer process argv (sandboxed preloads see the same array).
+ * @returns the declared role, or undefined when this renderer is not a shell window.
+ */
+export function desktopWindowRole(argv: readonly string[]): DesktopWindowRole | undefined {
+  // Every declaration must agree: two different roles mean the renderer cannot be
+  // classified, so it gets no desktop capability at all.
+  const declared = argv.filter(value => value.startsWith(ROLE_SWITCH)).map(value => value.slice(ROLE_SWITCH.length))
+  const role = declared.at(-1)
+  if (role === undefined || declared.some(value => value !== role)) return undefined
+  return role === 'local' || role === 'remote' ? role : undefined
+}
+
