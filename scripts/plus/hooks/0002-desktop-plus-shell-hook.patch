index 00000000..1f00c43a
--- /dev/null
+++ b/upstream/apps/desktop/tests/desktop-windows.spec.ts
@@ -0,0 +1,159 @@
+import { describe, expect, it } from 'vitest'
+import { DesktopWindows, documentOriginOf, isLoopbackOrigin, type DesktopIpcEvent } from '../src/desktop-windows.ts'
+
+/** Window fixture: the registry addresses a window by its contents id and main frame only. */
+function window(id: number) {
+  const mainFrame = { url: '' }
+  return { webContents: { id, mainFrame }, mainFrame }
+}
+
+/**
+ * A window that can be destroyed in place: after `destroy()` every `webContents`
+ * access throws the error Electron raises, exactly like a real closed window.
+ */
+function destroyableWindow(id: number) {
+  const mainFrame = { url: '' }
+  const contents = { id, mainFrame }
+  let destroyed = false
+  const window = {
+    mainFrame,
+    get webContents(): typeof contents {
+      if (destroyed) throw new TypeError('Object has been destroyed')
+      return contents
+    },
+    /** Mark the renderer gone, as `destroy()` does before `'closed'` fires. */
+    destroy(): void { destroyed = true },
+  }
+  return window
+}
+
+/** IPC event fixture from one window's top frame. */
+function eventOf(owner: ReturnType<typeof window>, frame = owner.webContents.mainFrame, url = 'dsh-app://app/'): DesktopIpcEvent {
+  frame.url = url
+  return { sender: owner.webContents, senderFrame: frame }
+}
+
+/** Registry over a role-labelled entry, which is what the shell registers. */
+function registry() {
+  return new DesktopWindows<{ readonly role: 'product' | 'profile'; readonly window: ReturnType<typeof window>; readonly profile?: string }>()
+}
+
+describe('desktop window ownership', () => {
+  it('authorizes the main frame of a pinned window and reports its entry', () => {
+    const windows = registry()
+    const product = window(1)
+    windows.register({ role: 'product', window: product }, 'dsh-app://app')
+    expect(windows.owner(eventOf(product))).toMatchObject({ role: 'product' })
+    expect(windows.list()).toHaveLength(1)
+    expect(windows.documentOrigin(product)).toBe('dsh-app://app')
+  })
+
+  it('authorizes a profile window after its document commits', () => {
+    const windows = registry()
+    const profile = window(2)
+    windows.register({ role: 'profile', window: profile, profile: 'work' })
+    expect(() => windows.owner(eventOf(profile))).toThrow('document moved')
+    windows.pinDocumentOrigin(profile, 'http://127.0.0.1:43110')
+    expect(windows.owner(eventOf(profile, profile.webContents.mainFrame, 'http://127.0.0.1:43110/dashboard')))
+      .toMatchObject({ role: 'profile', profile: 'work' })
+  })
+
+  it('rejects a renderer that belongs to no desktop window', () => {
+    const windows = registry()
+    const stranger = window(9)
+    expect(() => windows.owner(eventOf(stranger))).toThrow('unowned renderer')
+  })
+
+  it('rejects a subframe even when the window is pinned', () => {
+    const windows = registry()
+    const product = window(3)
+    windows.register({ role: 'product', window: product }, 'dsh-app://app')
+    const subframe = { url: 'dsh-app://app/' }
+    expect(() => windows.owner(eventOf(product, subframe))).toThrow('subframe')
+  })
+
+  it('rejects a pinned window whose document moved to another origin', () => {
+    const windows = registry()
+    const product = window(4)
+    windows.register({ role: 'product', window: product }, 'dsh-app://app')
+    expect(() => windows.owner(eventOf(product, product.webContents.mainFrame, 'https://elsewhere.example/')))
+      .toThrow('document moved')
+  })
+
+  it('rejects a destroyed sender frame', () => {
+    const windows = registry()
+    const product = window(5)
+    windows.register({ role: 'product', window: product }, 'dsh-app://app')
+    expect(() => windows.owner({ sender: product.webContents, senderFrame: null })).toThrow('subframe')
+  })
+
+  it('drops a window it forgets', () => {
+    const windows = registry()
+    const product = window(6)
+    windows.register({ role: 'product', window: product }, 'dsh-app://app')
+    windows.forget(product)
+    expect(windows.entryOf(product)).toBeUndefined()
+    expect(windows.list()).toEqual([])
+    expect(() => windows.owner(eventOf(product))).toThrow('unowned renderer')
+  })
+
+  it('forgets a window whose renderer is already destroyed', () => {
+    const windows = registry()
+    const gone = destroyableWindow(12)
+    windows.register({ role: 'profile', window: gone, profile: 'work' })
+    gone.destroy()
+    // 'closed' fires after the renderer is gone: cleanup must not dereference it.
+    expect(() => windows.forget(gone)).not.toThrow()
+    expect(windows.list()).toEqual([])
+    expect(windows.entryOf(gone)).toBeUndefined()
+  })
+
+  it('reads and pins a window without touching a destroyed renderer', () => {
+    const windows = registry()
+    const gone = destroyableWindow(13)
+    windows.register({ role: 'profile', window: gone, profile: 'work' })
+    gone.destroy()
+    expect(() => windows.pinDocumentOrigin(gone, 'http://127.0.0.1:43110')).not.toThrow()
+    expect(windows.documentOrigin(gone)).toBe('http://127.0.0.1:43110')
+  })
+
+  it('keeps entries apart by renderer, not by role', () => {
+    const windows = registry()
+    const product = window(7)
+    const profile = window(8)
+    windows.register({ role: 'product', window: product }, 'dsh-app://app')
+    windows.register({ role: 'profile', window: profile, profile: 'work' })
+    windows.pinDocumentOrigin(profile, 'http://127.0.0.1:43110')
+    expect(windows.owner(eventOf(product)).role).toBe('product')
+    expect(windows.owner(eventOf(profile, profile.webContents.mainFrame, 'http://127.0.0.1:43110/'))).toMatchObject({ role: 'profile', profile: 'work' })
+  })
+})
+
+describe('document origins', () => {
+  it('normalizes loopback spellings of the same Host', () => {
+    expect(documentOriginOf('http://localhost:43110/dashboard')).toBe('http://127.0.0.1:43110')
+    expect(documentOriginOf('http://127.0.0.1:43110/')).toBe('http://127.0.0.1:43110')
+    expect(documentOriginOf('http://127.0.0.1:43110/')).toBe(documentOriginOf('http://localhost:43110/other'))
+  })
+
+  it('keeps custom schemes and portless origins distinct', () => {
+    expect(documentOriginOf('dsh-app://app/index.html')).toBe('dsh-app://app')
+    expect(documentOriginOf('https://lane.example/')).toBe('https://lane.example')
+    expect(documentOriginOf('not a url')).toBe('')
+  })
+
+  it('authorizes a loopback profile window across a Host port restart', () => {
+    const windows = registry()
+    const profile = window(11)
+    windows.register({ role: 'profile', window: profile, profile: 'work' })
+    windows.pinDocumentOrigin(profile, 'http://localhost:43110')
+    expect(windows.owner(eventOf(profile, profile.webContents.mainFrame, 'http://127.0.0.1:43110/'))).toMatchObject({ role: 'profile' })
+  })
+
+  it('recognizes only loopback HTTP origins', () => {
+    expect(isLoopbackOrigin('http://127.0.0.1:43110')).toBe(true)
+    expect(isLoopbackOrigin('https://127.0.0.1:43110')).toBe(false)
+    expect(isLoopbackOrigin('http://lane.example')).toBe(false)
+    expect(isLoopbackOrigin('dsh-app://app')).toBe(false)
+  })
+})
