@@ -0,0 +1,170 @@
+/** Ownership and document-origin verification for every desktop-shell window. */
+
+import type { DesktopWindowRole } from './desktop-window.ts'
+
+/** The parts of a native window this registry addresses. */
+export interface DesktopWindowFrame {
+  /** Native window contents; its id identifies the renderer process. */
+  readonly webContents: { readonly id: number; readonly mainFrame: object }
+}
+
+/** One IPC sender as the registry needs to see it; Electron's own events satisfy this. */
+export interface DesktopIpcEvent {
+  /** Renderer that sent the request. */
+  readonly sender: { readonly id: number; readonly mainFrame: object }
+  /** Frame that sent the request, absent for a destroyed sender. */
+  readonly senderFrame: { readonly url: string } | null
+}
+
+/**
+ * Origin of a document URL, including custom schemes whose `URL.origin` is opaque.
+ *
+ * Loopback host names are normalized: `localhost`, `127.0.0.1`, and `[::1]` with
+ * the same port address one Host, and a Host that reports a different loopback
+ * spelling across restarts must keep its window authorized.
+ * @param url - document URL.
+ * @returns `scheme://host` for every scheme; '' when the URL cannot be parsed.
+ */
+export function documentOriginOf(url: string): string {
+  try {
+    const parsed = new URL(url)
+    const loopback = parsed.hostname === 'localhost' || parsed.hostname === '[::1]' || parsed.hostname === '::1'
+    const hostname = loopback ? '127.0.0.1' : parsed.hostname
+    return `${parsed.protocol}//${hostname}${parsed.port === '' ? '' : `:${parsed.port}`}`
+  } catch { return '' }
+}
+
+/**
+ * Whether an origin addresses a Host on this machine.
+ * @param origin - value produced by `documentOriginOf`.
+ * @returns true for a loopback HTTP origin.
+ */
+export function isLoopbackOrigin(origin: string): boolean {
+  try {
+    const url = new URL(origin)
+    return url.protocol === 'http:' && url.hostname === '127.0.0.1'
+  } catch { return false }
+}
+
+/** One window the shell constructed through its shared desktop-window path. */
+export interface DesktopWindowEntry {
+  /** The role the main process declared at construction. */
+  readonly role: DesktopWindowRole
+  /** The native window this entry describes. */
+  readonly window: DesktopWindowFrame
+}
+
+interface Registered<E> {
+  readonly entry: E
+  /**
+   * Origin of the document this window is allowed to run; undefined until its
+   * first committed main-frame load. IPC from a window without a pinned origin
+   * is rejected, so a fresh window cannot act before its document exists.
+   */
+  documentOrigin: string | undefined
+}
+
+/**
+ * Tracks the windows the shell itself created. Desktop capabilities attach to
+ * these windows rather than to one privileged window: whatever window a request
+ * comes from, the request is authorized by that window's own entry — its role,
+ * its main frame, and the origin it committed.
+ */
+export class DesktopWindows<E extends DesktopWindowEntry> {
+  private readonly byContents = new Map<number, Registered<E>>()
+  /**
+   * Renderer id captured at registration. A destroyed window throws on any
+   * `webContents` access, so cleanup and lookups read this instead of the window.
+   */
+  private readonly ids = new WeakMap<object, number>()
+
+  /**
+   * Renderer id of a registered window, captured before it could be destroyed.
+   * @param window - window to identify.
+   * @returns the captured id, or undefined for a window the shell did not create.
+   */
+  private idOf(window: E['window']): number | undefined {
+    return this.ids.get(window)
+  }
+
+  /**
+   * Record one desktop window.
+   * @param entry - window and declared role.
+   * @param documentOrigin - origin known at construction (the product window's document URL).
+   * @returns the recorded entry.
+   */
+  register(entry: E, documentOrigin?: string): E {
+    const id = entry.window.webContents.id
+    this.ids.set(entry.window, id)
+    this.byContents.set(id, { entry, documentOrigin })
+    return entry
+  }
+
+  /**
+   * Pin the origin of a window's committed document.
+   * @param window - window whose main frame committed.
+   * @param origin - origin of the committed document.
+   */
+  pinDocumentOrigin(window: E['window'], origin: string): void {
+    const normalized = documentOriginOf(origin)
+    const id = this.idOf(window)
+    const registered = id === undefined ? undefined : this.byContents.get(id)
+    if (registered !== undefined && normalized !== '') registered.documentOrigin = normalized
+  }
+
+  /**
+   * Drop a window when it is destroyed. The window is already gone, so this
+   * reads the id captured at registration rather than the window itself.
+   * @param window - destroyed window.
+   */
+  forget(window: E['window']): void {
+    const id = this.idOf(window)
+    if (id === undefined) return
+    this.byContents.delete(id)
+    this.ids.delete(window)
+  }
+
+  /**
+   * Read one window's entry without authorizing a request.
+   * @param window - window to look up.
+   * @returns the entry, or undefined for a window the shell did not create.
+   */
+  entryOf(window: E['window']): E | undefined {
+    const id = this.idOf(window)
+    return id === undefined ? undefined : this.byContents.get(id)?.entry
+  }
+
+  /** @returns every live desktop window, in registration order. */
+  list(): readonly E[] {
+    return [...this.byContents.values()].map(registered => registered.entry)
+  }
+
+  /**
+   * Read the origin a window is currently allowed to run.
+   * @param window - window to inspect.
+   * @returns the pinned origin, or undefined before the first committed load.
+   */
+  documentOrigin(window: E['window']): string | undefined {
+    const id = this.idOf(window)
+    return id === undefined ? undefined : this.byContents.get(id)?.documentOrigin
+  }
+
+  /**
+   * Authorize one IPC sender as the main frame of a desktop window whose
+   * committed document still has its pinned origin.
+   * @param event - IPC invocation or message event.
+   * @returns the owning window's entry.
+   */
+  owner(event: DesktopIpcEvent): E {
+    const registered = this.byContents.get(event.sender.id)
+    const frame = event.senderFrame
+    if (registered === undefined) throw new Error('dsh desktop: rejected IPC from an unowned renderer')
+    if (frame === null || frame !== event.sender.mainFrame) {
+      throw new Error('dsh desktop: rejected IPC from a subframe of a desktop window')
+    }
+    if (registered.documentOrigin === undefined || documentOriginOf(frame.url) !== registered.documentOrigin) {
+      throw new Error('dsh desktop: rejected IPC from a window whose document moved')
+    }
+    return registered.entry
+  }
+}
